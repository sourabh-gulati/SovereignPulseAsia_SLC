# Supabase Dashboard -> Connect -> Session pooler (recommended for
# IPv4-only local development and GitHub-hosted runners).
# Replace every placeholder. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Optional
CORS_ORIGINS=http://localhost:5173
